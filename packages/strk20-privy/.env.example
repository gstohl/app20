# Privy (Dashboard → App settings)
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Optional P-256 server authorization keypair for Wallet API raw_sign.
# Generate locally; keep the private half server-only. The public half is used
# when creating the wallet owner quorum.
PRIVY_WALLET_AUTH_PRIVATE_KEY=
PRIVY_WALLET_AUTH_PUBLIC_KEY=

# Starknet RPC — either Alchemy or a raw RPC URL
STARKNET_NETWORK=sepolia
ALCHEMY_API_KEY=
# RPC_URL=https://starknet-sepolia.public.blastapi.io/rpc/v0_10

# Ready account class hash. Default is official v0.5.0 (what Privy's
# returned Starknet address assumes).
# READY_CLASSHASH=0x073414441639dcd11d1846f287650a00c60c416b9d3ba45d31c651672125b2c2

# STRK20 privacy pool. Start in safe build-only mode; this uses the official
# call-based mock and direct contract discovery. It never submits private txs.
STRK20_POOL_ADDRESS=0x0254a6b2997ef52e9f830ce1f543f6b29768295e8d17e2267d672c552cfe0d91
STRK20_PROVER_MODE=mock

# When the real Sepolia services are ready, change mode to service and set both.
# STRK20_PROVER_MODE=service
STRK20_PROVING_URL=
STRK20_DISCOVERY_URL=

# Optional maturity polling controls (defaults: 8s poll, 15m timeout)
# STRK20_MATURITY_POLL_MS=8000
# STRK20_MATURITY_TIMEOUT_MS=900000

# Optional paymaster (AVNU SNIP-29) for deploy / gasless public txs
# PAYMASTER_URL=https://sepolia.paymaster.avnu.fi
# PAYMASTER_API_KEY=
# PAYMASTER_MODE=sponsored

# Optional passphrase used only by the example to derive a viewing key.
# Production wallets should use signed-message derivation (the default).
# STRK20_VIEWING_PASSPHRASE=

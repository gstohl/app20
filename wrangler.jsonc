{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "app20",
  "main": "workers/relay/src/worker.ts",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "upload_source_maps": false,
  "routes": [
    {
      "pattern": "app20.io",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "RELAY_GATE",
        "class_name": "RelayGateDurableObject"
      },
      {
        "name": "RESERVATION_LEDGER",
        "class_name": "ReservationLedgerDurableObject"
      },
      {
        "name": "CONFIDENTIAL_ROOMS",
        "class_name": "ConfidentialRoomsDurableObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RelayGateDurableObject"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["ReservationLedgerDurableObject"]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["ConfidentialRoomsDurableObject"]
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "STARKNET_MAINNET_RPC_URL": "https://api.cartridge.gg/x/starknet/mainnet",
    "STARKNET_SEPOLIA_RPC_URL": "https://api.cartridge.gg/x/starknet/sepolia",
    "RFQ_TRANSPORT_ENABLED": "false",
    "TRUST_CLIENT_IP_HEADERS": "true",
    "PRIVY_SUBMISSION_MODE": "live",
    "PRIVY_MAINNET_ENABLED": "true",
    "PRIVY_APP_ID": "cmsvq8r0q00om0cibkn7kgi30",
    "PRIVY_FRAME_ORIGINS": "https://auth.privy.io",
    "PRIVY_CONNECT_ORIGINS": "https://auth.privy.io,https://api.privy.io",
    "SEPOLIA_POOL_ADDRESS": "0x0254a6b2997ef52e9f830ce1f543f6b29768295e8d17e2267d672c552cfe0d91",
    "SEPOLIA_STRK_TOKEN_ADDRESS": "0x04718f5a0fc34cc1af16a1cdee98ffb20c31f5cd61d6ab07201858f4287c938d",
    "READY_ACCOUNT_CLASS_HASH": "0x073414441639dcd11d1846f287650a00c60c416b9d3ba45d31c651672125b2c2"
  }
}

# Copy this file to .env.local and fill in your values.

# Alchemy Starknet RPC key — used by the mainnet + sepolia providers in
# src/utils/constants.ts. Get one free at https://alchemy.com. The URL prefix is
# already set in constants.ts; paste ONLY the key here.
VITE_PROVIDER_URL=your_alchemy_key_here

# QuietlineMail helper. 0x0 = not deployed on that network.
VITE_MAIL_HELPER_SEPOLIA=0x0
VITE_MAIL_HELPER_MAINNET=0x0

# QuietlineEscrow. 0x0 = not deployed/reviewed on that network. Escrow is
# intentionally off the mainnet scoring path until contract review is complete.
VITE_ESCROW_HELPER_SEPOLIA=0x0
VITE_ESCROW_HELPER_MAINNET=0x0
# Normally generated by `npm run dev:localnet` alongside the local pool.
VITE_ESCROW_HELPER_LOCALNET=0x0

# Every VITE_* value is public and embedded in the browser bundle.
# Never place RPC credentials, Privy App Secret, prover/discovery origins,
# upstream authorization, OHTTP private keys, session secrets, NEAR Intents
# partner credentials, or TEE policy keys/endpoints here.

# Public Privy application metadata used only by the Sepolia Privacy Vault.
VITE_PRIVY_APP_ID=your_public_privy_app_id
VITE_PRIVY_CLIENT_ID=your_public_privy_app_client_id

# Public, independently reviewed RFC 9458 OHTTP HPKE key configurations.
# These are base64 key-config bytes, not gateway URLs or credentials.
VITE_PROVER_OHTTP_KEY_CONFIG=reviewed_public_base64_key_config
VITE_DISCOVERY_OHTTP_KEY_CONFIG=reviewed_public_base64_key_config

# App20Mail helper. 0x0 = not deployed on that network.
VITE_MAIL_HELPER_SEPOLIA=0x0
VITE_MAIL_HELPER_MAINNET=0x0

# App20Escrow. 0x0 = not deployed/reviewed on that network. Escrow is
# intentionally off the mainnet scoring path until contract review is complete.
VITE_ESCROW_HELPER_SEPOLIA=0x0
VITE_ESCROW_HELPER_MAINNET=0x0
# Normally generated by `npm run dev:localnet` alongside the local pool.
VITE_ESCROW_HELPER_LOCALNET=0x0

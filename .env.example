# Copy this file to .env.local and fill in your values.

# Alchemy Starknet RPC key — used by the mainnet + sepolia providers in
# src/utils/constants.ts. Get one free at https://alchemy.com. The URL prefix is
# already set in constants.ts; paste ONLY the key here.
VITE_PROVIDER_URL=your_alchemy_key_here

# QuietlineMail helper. 0x0 = not deployed on that network.
VITE_MAIL_HELPER_SEPOLIA=0x0
VITE_MAIL_HELPER_MAINNET=0x0
